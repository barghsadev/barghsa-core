# syntax=docker/dockerfile:1
# Barghsa API & Worker — shared multi-stage Dockerfile
#
# Builds the NestJS API and its workspace dependencies (db, shared, i18n).
# Uses `pnpm deploy` to produce a self-contained production bundle where
# all `workspace:*` dependencies are resolved into real package directories.
#
# The final image supports both `docker run` CMD override and Docker Compose
# `command` override, allowing the same image to serve as either the API server
# or a background worker.

# ─────────────────────────────────────────────────────────────
# Stage 1 — Install production + dev dependencies
# ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS deps

WORKDIR /app

# Node.js >=20 ships with corepack; enable pnpm
RUN corepack enable && corepack prepare pnpm@10 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile --prod=false

# ─────────────────────────────────────────────────────────────
# Stage 2 — Build and deploy
# ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10 --activate

# Reuse the dependency layer
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY --from=deps /app/node_modules ./node_modules

# Copy workspace packages needed by @barghsa/api
COPY packages/db ./packages/db
COPY packages/shared ./packages/shared
COPY packages/i18n ./packages/i18n
COPY apps/api ./apps/api

# Copy healthcheck script for the shared image
COPY scripts ./scripts

# Build the API app and its transitively referenced packages
RUN pnpm build --filter @barghsa/api

# Produce a self-contained production bundle with all workspace deps resolved
# into real directories (pnpm v10 requires --legacy for non-injected deploy)
RUN pnpm deploy --filter @barghsa/api --prod --legacy /app/prod

# ─────────────────────────────────────────────────────────────
# Stage 3 — Production image
# ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS production

ENV NODE_ENV=production \
    PORT=4000 \
    NODE_OPTIONS="--max-old-space-size=512"

WORKDIR /app

# Security: run as non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Security hardening notes (applied at runtime via docker-compose or k8s):
# - Capability drop: --cap-drop=ALL (ports 3000/4000 are non-privileged, no NET_BIND_SERVICE needed)
# - Read-only root filesystem: --read-only (volumes for /tmp if needed)

# Copy the self-contained production bundle
COPY --from=build /app/prod ./

# Copy healthcheck script (not included in pnpm deploy bundle)
COPY --from=build /app/scripts ./scripts

# Verify the entrypoint and healthcheck script exist
RUN test -f ./dist/src/main.js && test -f ./scripts/healthcheck-base.sh

EXPOSE 4000

USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD sh ./scripts/healthcheck-base.sh

# Default CMD — run the API server
# Override for worker: CMD ["node", "dist/src/worker.js"]
CMD ["node", "dist/src/main.js"]