# Stage 1: Dependencies — install all deps (dev + prod) needed for build
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy package manager manifests first for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages/tsconfig/package.json ./packages/tsconfig/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/i18n/package.json ./packages/i18n/package.json
COPY packages/db/package.json ./packages/db/package.json

RUN corepack enable && pnpm install --frozen-lockfile --prod=false

# Stage 2: Build — compile the NestJS API
FROM node:20-alpine AS build
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN corepack enable && \
    NODE_ENV=production pnpm build --filter @barghsa/api

# Stage 3: Production — minimal runtime image
FROM node:20-alpine AS production
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 appuser

WORKDIR /app

# Copy package.json so the ESM "type": "module" field applies to server.js / healthcheck.js
COPY --from=build /app/apps/api/package.json ./package.json

# Copy build artifacts
COPY --from=build /app/apps/api/dist ./dist

# Copy health check script
COPY apps/api/healthcheck.js ./healthcheck.js

# Production runtime hardening — single ENV to avoid overwrites
ENV NODE_ENV=production \
    NODE_OPTIONS="--max-old-space-size=512 --no-deprecation --inspect=0" \
    NODE_NO_WARNINGS=1

EXPOSE 4000

USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD node healthcheck.js

CMD ["node", "dist/src/main.js"]