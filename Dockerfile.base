# Build once with the complete workspace dependency graph.
FROM node:24-alpine@sha256:a34ab6d7f6f4813f4d0c5469d74685604b962fbdbf5793a7bc7b4998ecb867c8 AS deps
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --prod=false

FROM deps AS build
RUN pnpm -r --filter @barghsa/api... --filter @barghsa/worker... build
RUN pnpm --filter @barghsa/api deploy --prod /out/api
RUN pnpm --filter @barghsa/worker deploy --prod /out/worker

FROM node:24-alpine@sha256:a34ab6d7f6f4813f4d0c5469d74685604b962fbdbf5793a7bc7b4998ecb867c8 AS runtime
WORKDIR /app
RUN apk add --no-cache poppler-utils font-dejavu
# Package managers are needed only in the build stage.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY --from=build /out/api ./
COPY package.json ./root-package.json
COPY --from=build /out/worker ./worker/
COPY deploy/licenses/sharp-libvips/1.3.4/ ./licenses/sharp-libvips/1.3.4/
COPY scripts/healthcheck-runtime.cjs ./healthcheck-runtime.cjs
COPY scripts/run-packaged-migrations.cjs ./run-packaged-migrations.cjs
COPY scripts/run-packaged-seed.cjs ./run-packaged-seed.cjs
ENV NODE_ENV=production NODE_OPTIONS="--max-old-space-size=512"
USER node
EXPOSE 4000 9090 9091
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 CMD node healthcheck-runtime.cjs

# Compatibility target; production supports the identical command override.
FROM runtime AS worker
CMD ["node", "worker/dist/main.js"]

# Keep the API as the default target for existing build commands.
FROM runtime AS production
CMD ["node", "dist/src/main.js"]
