# Copy to /etc/barghsa/staging/backup.env; mode 0600, owned by root.
# Backup bucket must be outside this VPS, separate from its MinIO volume.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
BARGHSA_BACKUP_ENDPOINT=https://s3.example.com
BARGHSA_BACKUP_BUCKET=barghsa-staging-backups
BARGHSA_BACKUP_GPG_KEY_FILE=/etc/barghsa/staging/backup.key
