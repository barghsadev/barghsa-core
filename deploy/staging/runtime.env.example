# Copy to /etc/barghsa/staging/runtime.env; mode 0600, owned by root.
# Shell syntax: use single quotes around values containing spaces, #, or $.
# Prefer randomly generated hexadecimal secrets to avoid quoting mistakes.
# URL-encode special characters inside PostgreSQL URLs.
POSTGRES_DB=barghsa_staging
POSTGRES_USER=barghsa
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://barghsa:REPLACE@postgres:5432/barghsa_staging
PGDIRECT_URL=postgresql://barghsa:REPLACE@postgres:5432/barghsa_staging
REDIS_URL=redis://redis:6379/0

S3_ENDPOINT=http://objectstore:8333
S3_PRIVATE_ENDPOINT=http://objectstore:8333
S3_PUBLIC_ENDPOINT=https://s3.barghsa.com
S3_REGION=us-east-1
S3_BUCKET=barghsa-staging
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

APP_PUBLIC_URL=https://app.barghsa.com
API_PUBLIC_URL=https://app.barghsa.com
SESSION_SECRET=
CSRF_SECRET=
PROVIDER_CONFIG_ENCRYPTION_KEY=
AUTH_DELIVERY_ENCRYPTION_KEY=
AI_MODEL_ENCRYPTION_KEY=
STORAGE_CONFIG_ENCRYPTION_KEY=
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
NODE_ENV=production
LOG_LEVEL=info
OTP_CONSOLE=false

# Only for disposable staging with no backup destination configured.
# Otherwise configure backup.env and leave this false.
BARGHSA_DISPOSABLE=false
