# Included inside NGINX's http block.
limit_req_zone $binary_remote_addr zone=barghsa_auth:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=barghsa_upload:10m rate=5r/s;
map $http_upgrade $barghsa_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name {{ app_domain }} {{ s3_domain }};
    root /var/www/barghsa-acme;
    location ^~ /.well-known/acme-challenge/ { try_files $uri =404; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name {{ app_domain }};
    ssl_certificate /etc/letsencrypt/live/{{ app_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ app_domain }}/privkey.pem;
    server_tokens off;
    client_max_body_size 61m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location ^~ /api/auth/ {
        limit_req zone=barghsa_auth burst=5 nodelay;
        include /etc/nginx/snippets/barghsa-api-proxy.conf;
    }
    location ^~ /api/upload/ {
        limit_req zone=barghsa_upload burst=3 nodelay;
        include /etc/nginx/snippets/barghsa-api-proxy.conf;
    }
    location ^~ /api/ {
        include /etc/nginx/snippets/barghsa-api-proxy.conf;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $barghsa_connection_upgrade;
    }
}

server {
    listen 443 ssl http2;
    server_name {{ s3_domain }};
    ssl_certificate /etc/letsencrypt/live/{{ app_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ app_domain }}/privkey.pem;
    server_tokens off;
    client_max_body_size 61m;

    location / {
        add_header Access-Control-Allow-Origin 'https://{{ app_domain }}' always;
        add_header Access-Control-Allow-Methods 'GET, HEAD, PUT, POST, DELETE, OPTIONS' always;
        add_header Access-Control-Allow-Headers $http_access_control_request_headers always;
        add_header Access-Control-Expose-Headers 'ETag, Content-Length' always;
        add_header Access-Control-Max-Age 3600 always;
        if ($request_method = OPTIONS) { return 204; }
        proxy_pass http://127.0.0.1:8333;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
    }
}
