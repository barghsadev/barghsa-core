+
+func TestVersionedLifecycleRequiresCurrentBucketState(t *testing.T) {
+	tagged := &s3lifecycle.Rule{
+		ID:                              "temporary-objects",
+		Status:                          s3lifecycle.StatusEnabled,
+		ExpirationDays:                  7,
+		FilterTags:                      map[string]string{"legal-hold": "false"},
+		NoncurrentVersionExpirationDays: 1,
+		NewerNoncurrentVersions:         5,
+	}
+	multipart := &s3lifecycle.Rule{
+		ID: "multipart", Status: s3lifecycle.StatusEnabled, AbortMPUDaysAfterInitiation: 1,
+	}
+	compile := func(rules ...*s3lifecycle.Rule) *Snapshot {
+		input := CompileInput{Bucket: "documents", Rules: rules, Versioned: true}
+		snap := New().Compile([]CompileInput{input}, CompileOptions{})
+		for key := range snap.actions {
+			snap.MarkActive(key)
+		}
+		return snap
+	}
+	snap := compile(tagged, multipart)
+	baseline := compile(multipart)
+	window := 30 * 24 * time.Hour
+	replay, walk := snap.RulesForShard(0, window)
+	require.NotNil(t, replay)
+	require.NotNil(t, walk)
+	assert.Len(t, replay.actions, 1)
+	assert.Len(t, walk.actions, 2)
+	for _, kind := range []s3lifecycle.ActionKind{s3lifecycle.ActionKindExpirationDays, s3lifecycle.ActionKindNoncurrentDays} {
+		key := s3lifecycle.ActionKey{Bucket: "documents", RuleHash: s3lifecycle.RuleHash(tagged), ActionKind: kind}
+		assert.Contains(t, walk.actions, key)
+		assert.NotContains(t, snap.ReplayView(window).actions, key)
+	}
+	assert.Equal(t, ReplayContentHash(baseline), ReplayContentHash(snap))
+	assert.Equal(t, PromotedHash(baseline, window), PromotedHash(snap, window))
+	assert.Equal(t, 24*time.Hour, MaxEffectiveTTL(snap))
+}
