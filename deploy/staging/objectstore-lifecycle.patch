+func (s *Snapshot) requiresLiveVersionState(action *CompiledAction) bool {
+	if action == nil || action.Rule == nil {
+		return false
+	}
+	switch action.Key.ActionKind {
+	case s3lifecycle.ActionKindNoncurrentDays:
+		return action.Rule.NewerNoncurrentVersions > 0
+	case s3lifecycle.ActionKindExpirationDays:
+		return s.BucketVersioned(action.Bucket) && len(action.Rule.FilterTags) > 0
+	default:
+		return false
+	}
+}
