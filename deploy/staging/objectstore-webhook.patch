diff --git a/weed/notification/webhook/signed_delivery.go b/weed/notification/webhook/signed_delivery.go
new file mode 100644
index 0000000..e056b9a
--- /dev/null
+++ b/weed/notification/webhook/signed_delivery.go
@@ -0,0 +1,101 @@
+package webhook
+
+import (
+	"bytes"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+var (
+	signedBucketName = regexp.MustCompile(`^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$`)
+	signedVersionID  = regexp.MustCompile(`^[0-9a-f]{32}$`)
+	signedUploadKey  = regexp.MustCompile(`^uploads/[a-z][a-z0-9_-]{0,31}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(\.[a-z0-9]{1,32})?$`)
+)
+
+type signedDelivery struct {
+	endpoint string
+	bucket   string
+	key      []byte
+}
+
+type signedUploadEvent struct {
+	EventType string `json:"event_type"`
+	Bucket    string `json:"bucket"`
+	Key       string `json:"key"`
+	VersionID string `json:"version_id"`
+}
+
+func loadSignedDelivery(keyFile, bucket, endpoint string) (*signedDelivery, error) {
+	if keyFile == "" && bucket == "" {
+		return nil, nil
+	}
+	target, err := url.Parse(endpoint)
+	if keyFile == "" || !signedBucketName.MatchString(bucket) || err != nil ||
+		target.Scheme != "https" || target.Hostname() == "" || target.User != nil ||
+		target.RawQuery != "" || target.ForceQuery || target.Fragment != "" {
+		return nil, fmt.Errorf("signed storage webhook requires a key file, bucket and fixed HTTPS endpoint")
+	}
+	file, err := os.Open(keyFile)
+	if err != nil {
+		return nil, fmt.Errorf("could not open storage webhook signing key")
+	}
+	defer file.Close()
+	content, err := io.ReadAll(io.LimitReader(file, 129))
+	if err != nil || len(content) == 129 {
+		return nil, fmt.Errorf("could not read storage webhook signing key")
+	}
+	key, err := hex.DecodeString(strings.TrimSpace(string(content)))
+	if err != nil || len(key) != sha256.Size {
+		return nil, fmt.Errorf("storage webhook signing key must encode 32 bytes as hex")
+	}
+	return &signedDelivery{endpoint: target.String(), bucket: bucket, key: key}, nil
+}
+
+func (s *signedDelivery) request(path, eventType, version string, deleteMarker bool, now time.Time) (*http.Request, error) {
+	if eventType != "create" || deleteMarker || !signedVersionID.MatchString(version) {
+		return nil, nil
+	}
+	relative, inBucket := strings.CutPrefix(path, "/buckets/"+s.bucket+"/")
+	key, versionFile := strings.CutSuffix(relative, ".versions/v_"+version)
+	if !inBucket || !versionFile || !signedUploadKey.MatchString(key) {
+		return nil, nil
+	}
+
+	// The S3 version gets one identity even when the filer emits the event again.
+	payload, err := json.Marshal(signedUploadEvent{
+		EventType: "object-created",
+		Bucket:    s.bucket,
+		Key:       key,
+		VersionID: version,
+	})
+	if err != nil {
+		return nil, err
+	}
+	id := fmt.Sprintf("%x", sha256.Sum256(payload))
+	timestamp := strconv.FormatInt(now.Unix(), 10)
+	signature := hmac.New(sha256.New, s.key)
+	_, _ = signature.Write([]byte(id + "." + timestamp + "."))
+	_, _ = signature.Write(payload)
+
+	request, err := http.NewRequest(http.MethodPost, s.endpoint, bytes.NewReader(payload))
+	if err != nil {
+		return nil, err
+	}
+	request.Header.Set("Content-Type", "application/json")
+	request.Header.Set("X-Barghsa-Webhook-Id", id)
+	request.Header.Set("X-Barghsa-Webhook-Timestamp", timestamp)
+	request.Header.Set("X-Barghsa-Webhook-Signature", base64.StdEncoding.EncodeToString(signature.Sum(nil)))
+	return request, nil
+}
diff --git a/weed/notification/webhook/signed_delivery_test.go b/weed/notification/webhook/signed_delivery_test.go
new file mode 100644
index 0000000..07eb37f
--- /dev/null
+++ b/weed/notification/webhook/signed_delivery_test.go
@@ -0,0 +1,132 @@
+package webhook
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+const (
+	callbackBucket = "callback-fixture"
+	callbackKey    = "uploads/document/10f74629-8669-4b36-a1dc-89df2a7b9aad.pdf"
+	versionA       = "6716672bc6dce1dcbee268af1e7ff285"
+	versionB       = "6716672bc6dce1dcbee268af1e7ff286"
+)
+
+func testSignedDelivery(t *testing.T) *signedDelivery {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "key")
+	if err := os.WriteFile(path, []byte(strings.Repeat("ab", 32)+"\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	delivery, err := loadSignedDelivery(path, callbackBucket, "https://storage.example.test/internal/upload-event")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return delivery
+}
+
+func TestSignedUploadStableAcrossRetryAndDistinctVersions(t *testing.T) {
+	signed := testSignedDelivery(t)
+	at := time.Unix(1795133954, 0)
+	firstBody, firstID, firstSignature := func() (string, string, string) {
+		request, err := signed.request("/buckets/"+callbackBucket+"/"+callbackKey+".versions/v_"+versionA, "create", versionA, false, at)
+		if err != nil || request == nil {
+			t.Fatalf("request = %v, error = %v", request, err)
+		}
+		defer request.Body.Close()
+		body, err := io.ReadAll(request.Body)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if request.Method != "POST" || request.Header.Get("Content-Type") != "application/json" || request.Header.Get("Authorization") != "" {
+			t.Fatal("unexpected method or headers")
+		}
+		id := request.Header.Get("X-Barghsa-Webhook-Id")
+		signature := request.Header.Get("X-Barghsa-Webhook-Signature")
+		if id != fmt.Sprintf("%x", sha256.Sum256(body)) || request.Header.Get("X-Barghsa-Webhook-Timestamp") != "1795133954" {
+			t.Fatal("event ID or delivery timestamp mismatch")
+		}
+		expected := hmac.New(sha256.New, []byte(strings.Repeat("\xab", 32)))
+		fmt.Fprintf(expected, "%s.1795133954.%s", id, body)
+		if signature != base64.StdEncoding.EncodeToString(expected.Sum(nil)) {
+			t.Fatal("signature does not bind the ID, timestamp and exact payload")
+		}
+		return string(body), id, signature
+	}()
+	expectedBody := `{"event_type":"object-created","bucket":"callback-fixture","key":"uploads/document/10f74629-8669-4b36-a1dc-89df2a7b9aad.pdf","version_id":"6716672bc6dce1dcbee268af1e7ff285"}`
+	if firstBody != expectedBody {
+		t.Fatal("delivery contains unexpected metadata")
+	}
+	retry, err := signed.request("/buckets/"+callbackBucket+"/"+callbackKey+".versions/v_"+versionA, "create", versionA, false, at.Add(time.Second))
+	if err != nil || retry == nil {
+		t.Fatalf("retry request = %v, error = %v", retry, err)
+	}
+	defer retry.Body.Close()
+	body, err := io.ReadAll(retry.Body)
+	if err != nil || string(body) != firstBody {
+		t.Fatal("retry body changed")
+	}
+	if retry.Header.Get("X-Barghsa-Webhook-Id") != firstID || retry.Header.Get("X-Barghsa-Webhook-Signature") == firstSignature {
+		t.Fatal("retry must retain identity and sign the current delivery time")
+	}
+	other, err := signed.request("/buckets/"+callbackBucket+"/"+callbackKey+".versions/v_"+versionB, "create", versionB, false, at)
+	if err != nil || other == nil {
+		t.Fatalf("second object version request = %v, error = %v", other, err)
+	}
+	defer other.Body.Close()
+	if other.Header.Get("X-Barghsa-Webhook-Id") == firstID {
+		t.Fatal("a different version of the same key needs a separate identity")
+	}
+}
+
+func TestSignedUploadIgnoresFilerBookkeeping(t *testing.T) {
+	signed := testSignedDelivery(t)
+	base := "/buckets/" + callbackBucket + "/" + callbackKey
+	cases := []struct {
+		name, path, event, version string
+		marker                     bool
+	}{
+		{"latest pointer", base + ".versions", "update", versionA, false},
+		{"directory", base + ".versions", "create", "", false},
+		{"different bucket", "/buckets/unrelated/" + callbackKey + ".versions/v_" + versionA, "create", versionA, false},
+		{"delete marker", base + ".versions/v_" + versionA, "create", versionA, true},
+		{"other version", base + ".versions/v_" + versionA, "create", versionB, false},
+		{"other namespace", "/buckets/" + callbackBucket + "/logs/callback.pdf.versions/v_" + versionA, "create", versionA, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if request, err := signed.request(tc.path, tc.event, tc.version, tc.marker, time.Now()); err != nil || request != nil {
+				t.Fatalf("unexpected delivery: request = %v, error = %v", request, err)
+			}
+		})
+	}
+}
+
+func TestSignedDeliveryRequiresProtectedConfiguration(t *testing.T) {
+	if delivery, err := loadSignedDelivery("", "", ""); err != nil || delivery != nil {
+		t.Fatal("the new mode must be opt-in")
+	}
+	key := filepath.Join(t.TempDir(), "key")
+	if err := os.WriteFile(key, []byte(strings.Repeat("ab", 32)), 0600); err != nil {
+		t.Fatal(err)
+	}
+	for _, endpoint := range []string{"http://storage.example.test", "https://user@storage.example.test", "https://storage.example.test?token=fixture", "https://storage.example.test/#fragment"} {
+		if delivery, err := loadSignedDelivery(key, callbackBucket, endpoint); err == nil || delivery != nil {
+			t.Fatal("unsafe destination must be refused with a valid signing key")
+		}
+	}
+	if err := os.WriteFile(key, []byte("short"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if delivery, err := loadSignedDelivery(key, callbackBucket, "https://storage.example.test"); err == nil || delivery != nil {
+		t.Fatal("invalid signing key must be refused for a valid destination")
+	}
+}
