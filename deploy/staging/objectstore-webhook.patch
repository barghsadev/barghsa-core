+++ b/weed/notification/webhook/signed_http_test.go
@@ -0,0 +1,69 @@
+package webhook
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/seaweedfs/seaweedfs/weed/pb/filer_pb"
+	"github.com/seaweedfs/seaweedfs/weed/s3api/s3_constants"
+)
+
+func TestSignedWebhookUsesActualTLSAndDoesNotFollowRedirect(t *testing.T) {
+	deliveries := make(chan string, 2)
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/redirected" {
+			deliveries <- "redirected"
+			w.WriteHeader(http.StatusNoContent)
+			return
+		}
+		body, err := io.ReadAll(r.Body)
+		if err != nil || r.Header.Get("X-Barghsa-Webhook-Signature") == "" || r.Header.Get("Authorization") != "" {
+			deliveries <- "invalid signed request"
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		deliveries <- string(body)
+		http.Redirect(w, r, "/redirected", http.StatusTemporaryRedirect)
+	}))
+	defer server.Close()
+	key := filepath.Join(t.TempDir(), "signed-key")
+	if err := os.WriteFile(key, []byte(strings.Repeat("ab", 32)), 0600); err != nil {
+		t.Fatal(err)
+	}
+	client, err := newHTTPClient(&config{
+		endpoint: server.URL, signingKeyFile: key, signedBucket: callbackBucket,
+		authBearerToken: "fixture-bearer-for-unsigned-protocol", timeoutSeconds: 3,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	client.client.Transport = server.Client().Transport
+	err = client.sendMessage(&webhookMessage{
+		Key:       "/buckets/" + callbackBucket + "/" + callbackKey + ".versions/v_" + versionA,
+		EventType: "create",
+		Notification: &filer_pb.EventNotification{
+			NewEntry: &filer_pb.Entry{
+				Extended: map[string][]byte{s3_constants.ExtVersionIdKey: []byte(versionA)},
+			},
+		},
+	})
+	if err == nil || !strings.Contains(err.Error(), "status 307") {
+		t.Fatalf("signed webhook should reject a redirect, got %v", err)
+	}
+	select {
+	case body := <-deliveries:
+		if !strings.Contains(body, versionA) {
+			t.Fatal("authorized delivery did not reach the expected TLS receiver")
+		}
+	default:
+		t.Fatal("no authorized delivery reached the receiver")
+	}
+	if len(deliveries) != 0 {
+		t.Fatal("redirect received a follow-up submission")
+	}
+}
