{
  "uid": "barghsa-finance-safety",
  "title": "Barghsa Finance Safety",
  "tags": ["barghsa", "operations"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Overdue mandatory refunds",
      "description": "Counts mandatory obligations outstanding for more than one hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max without (instance, pod) (refund_obligations_overdue)",
          "legendFormat": "{{environment}}/{{database}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Wallets with critical drift",
      "description": "Counts wallets whose balances and ledger differ at or above the configured critical threshold.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max without (instance, pod) (reconciliation_wallets_critical_drift)",
          "legendFormat": "{{environment}}/{{database}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Seconds since payment callback anomaly",
      "description": "Shows time since the most recent callback rejection signal. An empty series has no observed anomaly.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max without (instance, pod, callback, reason) (payment_callback_last_anomaly_timestamp_seconds > 0)",
          "legendFormat": "{{environment}}/{{database}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Seconds since payment idempotency conflict",
      "description": "Shows time since the most recent conflicting reuse of a payment idempotency key.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max without (instance, pod, operation) (payment_idempotency_last_conflict_timestamp_seconds > 0)",
          "legendFormat": "{{environment}}/{{database}}"
        }
      ]
    }
  ]
}
