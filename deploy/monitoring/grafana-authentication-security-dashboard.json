{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 152, 48, 1)",
        "name": "Barghsa releases",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": ["barghsa-release"],
          "type": "tags"
        }
      }
    ]
  },
  "uid": "barghsa-authentication-security",
  "title": "Barghsa Authentication and Security",
  "description": "Sign-in, login MFA, OTP activity, API throttling and selected committed security events.",
  "tags": ["barghsa", "operations", "security"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up, environment)",
        "refresh": 1
      },
      {
        "name": "database",
        "label": "Database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{environment=\"$environment\"}, database)",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Sign-in submissions",
      "description": "Sign-in POST responses by HTTP status. The response can require another step before a session is established.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(barghsa_http_request_duration_seconds_count{environment=\"$environment\",database=\"$database\",route=\"/api/auth/login\",method=\"POST\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Login MFA pass and fail",
      "description": "Login OTP verification. Pass means a session was established. Fail counts rejected, missing or consumed challenges (401, 404 and 409).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (environment, database) (rate(barghsa_http_request_duration_seconds_count{environment=\"$environment\",database=\"$database\",route=\"/api/auth/login/verify\",method=\"POST\",status=\"200\"}[$__rate_interval]))",
          "legendFormat": "Pass",
          "refId": "A",
          "range": true
        },
        {
          "expr": "sum by (environment, database) (rate(barghsa_http_request_duration_seconds_count{environment=\"$environment\",database=\"$database\",route=\"/api/auth/login/verify\",method=\"POST\",status=~\"401|404|409\"}[$__rate_interval]))",
          "legendFormat": "Fail",
          "refId": "B",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "OTP deliveries marked sent",
      "description": "Provider acceptance recorded by the auth outbox, by channel. Recipient delivery has separate provider evidence.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (channel) (rate(auth_otp_deliveries_sent_total{environment=\"$environment\",database=\"$database\"}[$__rate_interval]))",
          "legendFormat": "{{channel}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "OTP verification submissions",
      "description": "Requests to the account OTP verification routes, including rejected requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(barghsa_http_request_duration_seconds_count{environment=\"$environment\",database=\"$database\",route=~\"/api/auth/(login/verify|reset-password/verify|register/verify|step-up/otp/verify|change-username|add-contact)\",method=\"POST\"}[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API rate-limit responses",
      "description": "API HTTP 429 responses by route template.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(barghsa_http_request_duration_seconds_count{environment=\"$environment\",database=\"$database\",status=\"429\"}[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Security audit collection health",
      "description": "1 means all reporting API replicas collected the audit window. 0 means at least one reported a collection failure.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "min by (environment, database) (security_audit_collection_success{environment=\"$environment\",database=\"$database\"})",
          "legendFormat": "Collection health",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Recent security audit events",
      "description": "Committed security events in the past hour by event type. Counts use one successful replica per environment and database.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max by (environment, database, event) (security_audit_events_1h{environment=\"$environment\",database=\"$database\"} and on (environment, database, job, instance) topk by (environment, database) (1, timestamp(security_audit_collection_success{environment=\"$environment\",database=\"$database\"}) and (security_audit_collection_success{environment=\"$environment\",database=\"$database\"} == 1)))",
          "legendFormat": "{{event}}",
          "refId": "A",
          "range": true
        }
      ]
    }
  ]
}
