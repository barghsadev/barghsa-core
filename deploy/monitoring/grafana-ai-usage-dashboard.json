{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Admitted completion attempts, including recovery probes. Requests denied before inference are excluded.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (environment, database, model_id, outcome) (increase(ai_model_completion_duration_seconds_count[1h]))",
          "legendFormat": "{{outcome}} · {{model_id}} ({{environment}} / {{database}})",
          "range": true,
          "refId": "A",
          "interval": "1h"
        }
      ],
      "title": "Model completion attempts per hour",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Tokens reported by providers for admitted completions, split by input and output.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (environment, database, model_id, direction) (increase(ai_model_reported_tokens_total[1h]))",
          "legendFormat": "{{direction}} · {{model_id}} ({{environment}} / {{database}})",
          "range": true,
          "refId": "A",
          "interval": "1h"
        }
      ],
      "title": "Reported tokens per hour",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Estimated committed USD budget charges in the preceding UTC day. Samples are plotted at the day’s end. Use the durable budget ledger and provider billing for reconciliation.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (environment, database, model_id) (increase(ai_model_budget_charged_usd_total[1d]))",
          "legendFormat": "{{model_id}} ({{environment}} / {{database}})",
          "range": true,
          "refId": "A",
          "interval": "1d"
        }
      ],
      "title": "Model budget charges by UTC day",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Share of admitted completion attempts that ended in error over five minutes. Periods without observed attempts have no value.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "percentunit",
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "(sum by (environment, database, model_id) (rate(ai_model_completion_duration_seconds_count{outcome=\"error\"}[5m])) or 0 * sum by (environment, database, model_id) (rate(ai_model_completion_duration_seconds_count[5m]))) / (sum by (environment, database, model_id) (rate(ai_model_completion_duration_seconds_count[5m])) > 0)",
          "legendFormat": "{{model_id}} ({{environment}} / {{database}})",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Model completion error ratio",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["barghsa", "ai", "observability"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
