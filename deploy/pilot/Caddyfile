# Barghsa Pilot Topology — Caddy Reverse Proxy
#
# Single-node pilot configuration with automatic TLS via Let's Encrypt.
# Use this as the primary proxy for the pilot deployment. It handles:
#   - API routing (/api/ → NestJS on :4000)
#   - Web SPA routing (/* → TanStack on :3000, SPA fallback handled by app)
#   - SSE/AI streaming via flush_interval -1 (no buffering)
#   - Automatic TLS certificate management
#   - Gzip/Zstandard compression
#   - Security headers
#   - Request body size limit (10 MB)
#   - Edge rate limiting for auth, upload, and AI endpoints
#
# Usage (standalone):
#   caddy run --config deploy/pilot/Caddyfile
#
# Usage (Docker Compose, with Let's Encrypt):
#   services:
#     caddy:
#       image: caddy:2-alpine
#       ports:
#         - "80:80"
#         - "443:443"
#       volumes:
#         - ./deploy/pilot/Caddyfile:/etc/caddy/Caddyfile:ro
#         - caddy_data:/data
#       depends_on:
#         - web
#         - api
#
# Upstreams:
#   web  — TanStack Start SPA server   127.0.0.1:3000
#   api  — NestJS API server            127.0.0.1:4000

barghsa.example.com {
	tls {
		# Let's Encrypt production directory
		# issuer acme
		# For staging/testing, uncomment:
		# issuer acme https://acme-staging-v02.api.letsencrypt.org/directory
	}

	# ──────────────────────────────────────────────
	# API upstream  —  /api/*  →  NestJS on :4000
	# Rate-limited paths (auth, upload, AI) — defence-in-depth
	# Application-level rate limits remain the primary control
	# ──────────────────────────────────────────────

	handle /api/auth/* {
		rate_limit {
			zone auth_limit {
				key {remote_host}
				rate 10 r/s
				burst 5
			}
		}
		reverse_proxy 127.0.0.1:4000 {
			flush_interval -1
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /api/upload/* {
		rate_limit {
			zone upload_limit {
				key {remote_host}
				rate 5 r/s
				burst 3
			}
		}
		reverse_proxy 127.0.0.1:4000 {
			flush_interval -1
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /api/ai/* {
		rate_limit {
			zone ai_limit {
				key {remote_host}
				rate 5 r/s
				burst 2
			}
		}
		reverse_proxy 127.0.0.1:4000 {
			flush_interval -1
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:4000 {
			flush_interval -1
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ──────────────────────────────────────────────
	# Static asset caching — hashed filenames under /assets/
	# Cache: public, immutable, 1 year
	# ──────────────────────────────────────────────
	handle /assets/* {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
		header {
			Cache-Control "public, immutable, max-age=31536000"
			Vary "Accept-Encoding"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			X-Frame-Options "DENY"
			Content-Security-Policy-Report-Only "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; script-src 'strict-dynamic' 'nonce-{http.request.header.csp-nonce}' 'unsafe-inline' https: http:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; form-action 'self'; report-uri /api/csp-report"
		}
	}

	# ──────────────────────────────────────────────
	# Other static files (non-hashed) — 1-day cache
	# ──────────────────────────────────────────────
	@non_asset_static {
		path_regexp \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot|webp|avif)$
		not path /assets/*
	}
	handle @non_asset_static {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
		header {
			Cache-Control "public, max-age=86400"
			Vary "Accept-Encoding"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			X-Frame-Options "DENY"
			Content-Security-Policy-Report-Only "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; script-src 'strict-dynamic' 'nonce-{http.request.header.csp-nonce}' 'unsafe-inline' https: http:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; form-action 'self'; report-uri /api/csp-report"
		}
	}

	# ──────────────────────────────────────────────
	# Web upstream  —  /*  →  TanStack SPA on :3000
	# ──────────────────────────────────────────────
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ──────────────────────────────────────────────
	# Compression  —  Gzip + Zstandard
	# ──────────────────────────────────────────────
	encode gzip zstd

	# ──────────────────────────────────────────────
	# Security headers (every response)
	# ──────────────────────────────────────────────
	header {
		# Prevent MIME-type sniffing
		X-Content-Type-Options "nosniff"
		# Strict referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"
		# Block camera, microphone, geolocation access
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Deny framing via both CSP and legacy header
		X-Frame-Options "DENY"
		# Start CSP in Report-Only mode — collect violations before enforcing
		# When all violations are resolved, change to Content-Security-Policy
		Content-Security-Policy-Report-Only "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; script-src 'strict-dynamic' 'nonce-{http.request.header.csp-nonce}' 'unsafe-inline' https: http:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; form-action 'self'; report-uri /api/csp-report"
	}

	# ──────────────────────────────────────────────
	# Request body size limit
	# ──────────────────────────────────────────────
	request_body {
		max_size 10MB
	}

	# ──────────────────────────────────────────────
	# Structured logging
	# ──────────────────────────────────────────────
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MB
			roll_keep 5
		}
		format json
		level INFO
	}

	# ──────────────────────────────────────────────
	# Error responses
	# ──────────────────────────────────────────────
	handle_errors {
		@429 `{http.error.status_code} == 429`
		header @429 Retry-After "1"
		respond @429 429 {
			body "{\"error\":\"rate_limit_exceeded\",\"message\":\"Too many requests. Please try again later.\"}"
		}
	}
}