# Barghsa Core — Environment Variables
#
# Copy this file to .env and fill in the secrets.
# For local development, most values are pre-filled with sensible defaults.

# --- Database ---
# PostgreSQL connection string for Drizzle ORM and pg-pool.
DATABASE_URL=postgresql://barghsa:***@localhost:5432/barghsa

# PgBouncer connection string (optional — takes precedence over DATABASE_URL).
# Use this when PgBouncer is deployed as a sidecar or separate container.
# PgBouncer exposes port 6432 by default.
# PGBOUNCER_URL=postgresql://barghsa:***@localhost:6432/barghsa

# Direct PostgreSQL connection that bypasses PgBouncer (optional).
# Used for admin operations, migrations, and session-level features.
# Falls back to DATABASE_URL when not set.
# PGDIRECT_URL=postgresql://barghsa:***@localhost:5432/barghsa

# --- TLS / SSL for Managed PostgreSQL ---
# Enable TLS for the PostgreSQL connection. Set to "true" when connecting to
# a managed PostgreSQL instance (RDS, Cloud SQL, etc.) over the network.
# When unset or "false", TLS is not explicitly enabled (the pg library still
# honours ?sslmode= in the connection string if present).
# DATABASE_SSL_ENABLED=false

# Filesystem path to the CA certificate bundle used for server certificate
# validation. Required when connecting to managed PostgreSQL with a custom CA.
# Example: /etc/ssl/certs/rds-ca-bundle.pem
# DATABASE_CA_PATH=

# When TLS is enabled and a CA path is set, controls whether to reject
# connections with an invalid server certificate. Set to "false" only for
# troubleshooting (never in production).
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- Redis ---
# Redis connection string for rate-limiting, caching, and session store.
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3-compatible object storage) ---
# Endpoint hostname (use the service name inside Docker Compose).
MINIO_ENDPOINT=localhost
# MinIO API port (9000 for the S3-compatible API).
MINIO_PORT=9000
# MinIO access key (generate a random 20+ char string).
MINIO_ACCESS_KEY=minioadmin
# MinIO secret key (generate a random 40+ char string).
MINIO_SECRET_KEY=minioadmin
# Default bucket for file uploads (created automatically on first init).
MINIO_BUCKET=barghsa
# Disable SSL for local development; enable in production.
MINIO_USE_SSL=false

# --- Backup & WAL Archiving ---
# S3-compatible endpoint for PostgreSQL backup storage (must be reachable
# from the database server; inside Docker Compose use the service name).
BACKUP_S3_ENDPOINT=http://localhost:9000
# S3 bucket for full backups and WAL archives.
BACKUP_S3_BUCKET=barghsa-backups
# S3 access/secret keys (use the same credentials as MinIO for local dev).
BACKUP_S3_ACCESS_KEY=minioadmin
BACKUP_S3_SECRET_KEY=minioadmin
# Number of daily full backups to retain (default: 14).
# BACKUP_RETENTION_DAYS=14

# --- Config & File Backup (T-04.01.07) ---
# GPG passphrase for encrypting config/file backups (set in vault; never committed).
# When unset, backup-config.sh prompts interactively.
# GPG_PASSPHRASE=
# GPG recipient key ID for asymmetric encryption (alternative to GPG_PASSPHRASE).
# GPG_RECIPIENT=
# Config backup retention in days (default: 90).
# CONFIG_BACKUP_RETENTION_DAYS=90

# --- API Server ---
# Port the NestJS API server listens on.
PORT=4000

# --- Authentication & Security ---
# Session encryption secret (generate: `openssl rand -hex 32`).
SESSION_SECRET=
# CSRF token secret (generate: `openssl rand -hex 32`).
CSRF_SECRET=
# Email provider secrets encryption key (T-05.06.05).
# AES-256 key as 64 hex chars — generate: `openssl rand -hex 32`.
# Without it, provider configs can still be created but secret fields
# (SMTP password, Resend API key) are NOT encrypted at rest.
PROVIDER_CONFIG_ENCRYPTION_KEY=

# AI model API token encryption key (T-09.11.01).
# AES-256 key as 64 hex chars — generate: `openssl rand -hex 32`.
# Required to create/update AI models with an API token; tokens fail closed
# (creation is refused) when the key is missing — they are never stored
# plaintext.
AI_MODEL_ENCRYPTION_KEY=

# Optional comma-separated allow-list of AI model base-URL hosts that bypass
# the tester's SSRF private-range block (e.g. a local Ollama: `localhost`).
AI_MODEL_BASE_URL_ALLOWLIST=

# Optional AI model test-ping timeout in milliseconds (default 15000,
# clamped to [1000, 60000]).
AI_MODEL_TEST_TIMEOUT_MS=15000

# --- Payment gateway (online wallet top-up, T-04.2.02.01) ---
# Adapter: zarinpal (production default), http (generic JSON PSP), or
# redirect (local URL builder — development/test only; refused in production).
# PAYMENT_GATEWAY_ADAPTER=zarinpal
# ZarinPal merchant UUID (required when adapter=zarinpal).
# PAYMENT_GATEWAY_MERCHANT_ID=
# Generic HTTP PSP (required together when adapter=http).
# PAYMENT_GATEWAY_REQUEST_URL=https://payment.zarinpal.com/pg/v4/payment/request.json
# PAYMENT_GATEWAY_API_KEY=
# Hosted-checkout / StartPay base URL. Used by redirect and as the ZarinPal
# StartPay prefix; also used by http when the provider omits redirectUrl.
# Must be https. Its host is added to the gateway redirect allow-list.
# PAYMENT_GATEWAY_START_URL=https://payment.zarinpal.com/pg/StartPay
# Extra comma-separated hosts allowed in provider-supplied redirect URLs
# (in addition to hosts from REQUEST_URL / START_URL). Exact match only.
# PAYMENT_GATEWAY_ALLOWED_HOSTS=payment.zarinpal.com
# Optional request timeout in milliseconds (default 15000, clamped 1000–60000).
# PAYMENT_GATEWAY_TIMEOUT_MS=15000
# Optional inquiry URL used to recover an existing payable session after a
# timeout (GET for http; ZarinPal unVerified.json is derived from REQUEST_URL).
# PAYMENT_GATEWAY_INQUIRY_URL=
# HMAC secret used to authenticate server-to-server top-up callbacks
# (T-04.2.02.02). Required in production; the browser redirect is never
# treated as proof of payment.
# PAYMENT_GATEWAY_WEBHOOK_SECRET=
# Optional HTTP-adapter verify URL used for the server-side paid check.
# ZarinPal derives verify.json from REQUEST_URL.
# PAYMENT_GATEWAY_VERIFY_URL=
# Public API origin used to build the provider callback URL
# (`/api/wallet/top-ups/callback`, verified in T-04.2.02.02).
# Required in production: an explicit public https origin (not localhost/IP).
# API_PUBLIC_URL=http://localhost:4000
#
# Online Pending top-up TTL expiry cron (T-04.2.02.07). The worker
# auto-rejects online top-ups still Pending after this TTL. Provider
# authority stays on metadata so a later authenticated callback can
# still credit. Invalid or sub-second TTL falls back to 30 minutes.
# ONLINE_TOPUP_PENDING_TTL_MS=1800000
# Scan interval (default 60s; invalid values fall back to 60s).
# ONLINE_TOPUP_EXPIRY_SCAN_MS=60000
# Audit actor for system-initiated expiry (and invoice overdue). When
# unset, the worker uses the oldest platform admin.
# WORKER_SYSTEM_ACTOR_USER_ID=

# --- Application ---
# Runtime environment.
NODE_ENV=development

# --- CDN (production only; leave empty for dev) ---
CDN_URL=

# --- Logging ---
# Log verbosity: debug, info, warn, error.
LOG_LEVEL=debug

# --- Development-only: OTP Console ---
# When true, one-time passwords (OTP) are printed to the server console
# instead of being sent via email/SMS. Useful for local development.
OTP_CONSOLE=true

# --- Optional: Admin Bootstrap ---
# Uncomment and set to auto-create an admin account on first startup.
# ADMIN_BOOTSTRAP_SECRET=
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=