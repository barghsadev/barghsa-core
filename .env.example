# Barghsa Core — Environment Variables

# --- Database ---
DATABASE_URL=postgresql://barghsa:barghsa@localhost:5432/barghsa

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- CDN (production only; leave empty for dev) ---
CDN_URL=

# --- API ---
PORT=4000

# --- Authentication ---
# JWT_SECRET=your-secret-here
# SESSION_SECRET=your-session-secret

# --- Logging ---
LOG_LEVEL=debug

# --- Deployment ---
NODE_ENV=development