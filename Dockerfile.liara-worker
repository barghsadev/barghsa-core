# Liara builds the final stage and cannot select Dockerfile.base's worker target.
FROM node:24-bookworm-slim AS deps
WORKDIR /app
RUN corepack enable
COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/tsconfig/package.json packages/tsconfig/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/db/package.json packages/db/package.json
RUN pnpm --filter @barghsa/api... --filter @barghsa/worker... install --frozen-lockfile --prod=false
COPY . .

FROM deps AS build
RUN pnpm -r --filter @barghsa/api... --filter @barghsa/worker... build
RUN pnpm --filter @barghsa/api deploy --prod /out/api
RUN pnpm --filter @barghsa/worker deploy --prod /out/worker

FROM node:24-bookworm-slim AS production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/api ./
COPY --from=build /out/worker ./worker/
COPY scripts/healthcheck-runtime.cjs ./healthcheck-runtime.cjs
ENV NODE_ENV=production NODE_OPTIONS="--max-old-space-size=512"
USER node
EXPOSE 9090
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 CMD node healthcheck-runtime.cjs
CMD ["node", "worker/dist/main.js"]
