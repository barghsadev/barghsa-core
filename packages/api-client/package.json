{
  "name": "@barghsa/api-client",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && cp src/openapi.generated.d.ts dist/openapi.generated.d.ts",
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript ../../apps/api/openapi.json --output src/openapi.generated.d.ts",
    "check": "openapi-typescript ../../apps/api/openapi.json --output src/openapi.generated.d.ts --check"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
