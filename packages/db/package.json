{
    "name": "@barghsa/db",
    "version": "0.0.0",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./config": "./dist/schema/config.js",
        "./schema/storage-record": "./dist/schema/storage-record.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc -b",
        "dev": "drizzle-kit push",
        "test": "vitest run --passWithNoTests",
        "test:coverage": "vitest run --coverage --passWithNoTests",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:migrate:run": "tsx src/migrate.ts",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:verify-restore": "./scripts/backup/verify-restore.sh",
        "db:seed": "tsx src/seed/index.ts"
    },
    "dependencies": {
        "argon2": "^0.41.0",
        "drizzle-orm": "^0.40.0",
        "pg": "^8.14.0",
        "uuid": "^14.0.0"
    },
    "devDependencies": {
        "@barghsa/shared": "workspace:*",
        "@testcontainers/postgresql": "12.1.0",
        "@types/pg": "^8.11.0",
        "@types/uuid": "11.0.0",
        "drizzle-kit": "^0.30.0",
        "testcontainers": "12.1.0",
        "tsx": "4.23.12"
    }
}