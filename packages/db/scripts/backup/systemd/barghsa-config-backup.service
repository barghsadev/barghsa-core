[Unit]
Description=Barghsa verified encrypted configuration backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=postgres
Group=postgres
UMask=0077
WorkingDirectory=/var/lib/barghsa-backup
Environment="PATH=/opt/barghsa-backup/.venv/bin:/usr/lib/postgresql/16/bin:/usr/bin:/bin"
EnvironmentFile=/etc/barghsa/config-backup.env
ExecStart=/opt/barghsa-backup/.venv/bin/python3 /opt/barghsa-backup/config_backup.py job
TimeoutStartSec=3h
