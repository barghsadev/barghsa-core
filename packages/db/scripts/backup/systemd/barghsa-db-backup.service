[Unit]
Description=Barghsa verified encrypted PostgreSQL backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=postgres
Group=postgres
UMask=0077
WorkingDirectory=/var/lib/barghsa-backup
Environment="PATH=/opt/barghsa-backup/.venv/bin:/usr/lib/postgresql/16/bin:/usr/bin:/bin"
EnvironmentFile=/etc/barghsa/backup.env
ExecStart=/opt/barghsa-backup/backup-pg.sh
ExecStartPost=/opt/barghsa-backup/.venv/bin/python3 /opt/barghsa-backup/physical_backup.py prune
TimeoutStartSec=3h
