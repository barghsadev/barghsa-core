{
  "name": "@barghsa/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./src/styles.css",
    "./sonner": {
      "import": {
        "types": "./dist/sonner.d.ts",
        "default": "./dist/sonner.js"
      },
      "require": {
        "types": "./dist/sonner.d.cts",
        "default": "./dist/sonner.cjs"
      }
    },
    "./form": {
      "import": {
        "types": "./dist/form/index.d.ts",
        "default": "./dist/form/index.js"
      },
      "require": {
        "types": "./dist/form/index.d.cts",
        "default": "./dist/form/index.cjs"
      }
    },
    "./direction-provider": {
      "import": {
        "types": "./dist/direction-provider.d.ts",
        "default": "./dist/direction-provider.js"
      },
      "require": {
        "types": "./dist/direction-provider.d.cts",
        "default": "./dist/direction-provider.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup && node --test scripts/distribution.check.mjs",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "stories": "ladle serve",
    "stories:build": "ladle build",
    "stories:preview": "ladle preview",
    "stories:typecheck": "tsc -p tsconfig.stories.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tailwindcss/postcss": "4.3.3",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "date-fns-jalali": "4.4.0-0",
    "lucide-react": "1.34.0",
    "next-themes": "0.4.6",
    "postcss": "^8.5.26",
    "react": "^19.1.0",
    "react-day-picker": "10.0.1",
    "react-dom": "^19.1.0",
    "react-hook-form": "7.89.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@barghsa/tsconfig": "workspace:*",
    "@ladle/react": "5.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/styles.css",
    "src/fonts",
    "tailwind.config.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
