FROM node:24-alpine@sha256:a34ab6d7f6f4813f4d0c5469d74685604b962fbdbf5793a7bc7b4998ecb867c8 AS deps
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --prod=false

FROM deps AS build
ARG BARGHSA_RELEASE_SHA
ENV BARGHSA_RELEASE_SHA=$BARGHSA_RELEASE_SHA
ENV BARGHSA_LICENSE_INVENTORY_DIR=/app/browser-license-inventory
RUN pnpm -r --filter @barghsa/web... build
RUN pnpm --filter @barghsa/telemetry deploy --prod /out/telemetry

FROM node:24-alpine@sha256:a34ab6d7f6f4813f4d0c5469d74685604b962fbdbf5793a7bc7b4998ecb867c8 AS production
WORKDIR /app
# Keep the server's telemetry dependencies separate from the browser workspace.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY --from=build /app/apps/web/package.json ./package.json
COPY --from=build /app/apps/web/dist ./dist
COPY --from=build /app/browser-license-inventory ./browser-license-inventory
COPY --from=build /out/telemetry ./node_modules/@barghsa/telemetry
COPY apps/web/server.js apps/web/healthcheck.js apps/web/entry-routes.js apps/web/environment-indicator.js ./
ARG BARGHSA_RELEASE_SHA
LABEL org.opencontainers.image.revision=$BARGHSA_RELEASE_SHA
ENV NODE_ENV=production NODE_OPTIONS="--max-old-space-size=512 --no-deprecation"
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 CMD node healthcheck.js
CMD ["node", "server.js"]
