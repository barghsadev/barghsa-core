FROM node:24-bookworm-slim AS deps
WORKDIR /app
RUN corepack enable
COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY packages/tsconfig/package.json packages/tsconfig/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN pnpm --filter @barghsa/web... install --frozen-lockfile --prod=false
COPY . .

FROM deps AS build
RUN pnpm -r --filter @barghsa/web... build

FROM node:24-bookworm-slim AS production
WORKDIR /app
COPY --from=build /app/apps/web/package.json ./package.json
COPY --from=build /app/apps/web/dist ./dist
COPY apps/web/server.js apps/web/healthcheck.js apps/web/entry-routes.js ./
ENV NODE_ENV=production NODE_OPTIONS="--max-old-space-size=512"
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 CMD node healthcheck.js
CMD ["node", "server.js"]
