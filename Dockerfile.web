# Stage 1: Dependencies — install all deps (dev + prod) needed for build
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy package manager manifests first for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages/tsconfig/package.json ./packages/tsconfig/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/i18n/package.json ./packages/i18n/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/db/package.json ./packages/db/package.json

RUN corepack enable && pnpm install --frozen-lockfile --prod=false

# Stage 2: Build — compile the web frontend
FROM node:20-alpine AS build
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN corepack enable && \
    NODE_ENV=production pnpm build --filter @barghsa/web

# Remove devDependencies from each workspace node_modules for smaller size
RUN find . -path '*/node_modules' -prune -o -type d -name 'node_modules' -prune | \
    while IFS= read -r dir; do \
      [ -d "$dir/.pnpm" ] && rm -rf "$dir/.pnpm"; \
      rm -rf "$dir"/*/node_modules; \
    done 2>/dev/null; true

# Stage 3: Production — minimal runtime image
FROM node:20-alpine AS production
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 appuser && \
    # Drop libc6-compat — not needed at runtime
    apk del libc6-compat 2>/dev/null; true

WORKDIR /app

# Copy only the built frontend assets
COPY --from=build /app/apps/web/dist ./dist

# Copy production static server
COPY apps/web/server.js ./server.js
COPY apps/web/healthcheck.js ./healthcheck.js

# Production runtime hardening
ENV NODE_ENV=production \
    NODE_OPTIONS="--max-old-space-size=512" \
    NODE_NO_WARNINGS=1

# Disable inspector and insecure parser
ENV NODE_OPTIONS="--max-old-space-size=512 --no-deprecation" \
    NODE_PENDING_DEPRECATION=0

EXPOSE 3000

USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node healthcheck.js

CMD ["node", "server.js"]
