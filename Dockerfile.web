FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm -r --filter @barghsa/web... build

FROM node:24-bookworm-slim AS production
WORKDIR /app
COPY --from=build /app/apps/web/package.json ./package.json
COPY --from=build /app/apps/web/dist ./dist
COPY apps/web/server.js apps/web/healthcheck.js ./
ENV NODE_ENV=production NODE_OPTIONS="--max-old-space-size=512"
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 CMD node healthcheck.js
CMD ["node", "server.js"]
