{
  "name": "barghsa-core",
  "private": true,
  "version": "0.0.0",
  "description": "Barghsa — Iranian electricity market intelligence platform",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:docker": "CHOKIDAR_USEPOLLING=true TURBO_DAEMON=false TSC_WATCHFILE=UseFsEventsWithPolling turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "check:suppressed-errors": "./scripts/check-suppressed-errors.sh",
    "setup:bucket": "ts-node scripts/setup-bucket.ts",
    "format:check": "turbo format:check",
    "format:write": "turbo format:write",
    "check:bundle": "size-limit"
  },
  "devDependencies": {
    "@size-limit/preset-app": "13.0.3",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "28.1.0",
    "size-limit": "13.0.3",
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ],
    "overrides": {}
  }
}