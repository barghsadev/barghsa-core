{
  "name": "barghsa-core",
  "private": true,
  "version": "0.5.1",
  "description": "Barghsa \u2014 Iranian electricity market intelligence platform",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "nodemon --config nodemon.json",
    "dev:docker": "WEB_HOST=0.0.0.0 CHOKIDAR_USEPOLLING=true nodemon --legacy-watch --config nodemon.json",
    "setup:dev": "node scripts/setup-dev.mjs",
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo typecheck",
    "check:suppressed-errors": "./scripts/check-suppressed-errors.sh",
    "setup:bucket": "pnpm --filter @barghsa/shared build && node packages/shared/scripts/setup-bucket.mjs",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "check:contract": "node --test scripts/check-openapi.test.mjs && node scripts/check-openapi.mjs && pnpm --filter @barghsa/api-client check",
    "contract:update": "pnpm --filter @barghsa/api build && node scripts/check-openapi.mjs --write && pnpm --filter @barghsa/api-client generate",
    "check:bundle": "node --test scripts/check-route-budgets.test.mjs && node scripts/check-route-budgets.mjs",
    "db:seed": "pnpm --filter @barghsa/db db:seed",
    "check:db-snapshot": "node --test packages/db/scripts/check-snapshot.test.mjs && node packages/db/scripts/check-snapshot.mjs",
    "dev:prepare": "pnpm exec turbo build --filter=@barghsa/db... && pnpm --filter @barghsa/db db:migrate && pnpm db:seed",
    "dev:run": "pnpm dev:prepare && turbo dev --filter='./apps/*' --env-mode=loose"
  },
  "devDependencies": {
    "@barghsa/eslint-config": "workspace:*",
    "@bcoe/v8-coverage": "1.0.2",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.0",
    "@jridgewell/remapping": "2.3.5",
    "@size-limit/file": "12.1.0",
    "@stryker-mutator/core": "9.3.0",
    "@stryker-mutator/vitest-runner": "9.3.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "acorn": "8.18.0",
    "ast-v8-to-istanbul": "1.0.5",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "istanbul-lib-coverage": "3.2.2",
    "jsdom": "28.1.0",
    "lint-staged": "15.5.2",
    "nodemon": "3.1.14",
    "prettier": "3.9.6",
    "size-limit": "12.1.0",
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ],
    "overrides": {
      "@stryker-mutator/core@9.3.0>minimatch": "10.2.6",
      "@stryker-mutator/core@9.3.0>mutation-server-protocol": "0.4.1",
      "mutation-server-protocol@0.4.1>zod": "4.6.6",
      "@grpc/grpc-js@>=1.14.0 <1.14.5": "1.14.5",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "drizzle-kit@0.31.10>@esbuild-kit/esm-loader": "-",
      "qs@<6.16.0": "6.16.0",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "undici@7": "7.30.1",
      "undici@8": "8.12.2",
      "piscina@<4.9.4": "4.9.4",
      "fast-uri": "3.1.8",
      "esbuild@>=0.27.3 <0.28.1": "0.28.2",
      "multer@<2.5.0": "2.5.0",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "shell-quote@>=1.8.4 <1.11.0": "1.11.0",
      "seroval@<1.6.8": "1.6.8",
      "decode-uri-component@<0.5.1": "0.5.1",
      "vite@6": "6.4.4",
      "@ladle/react@5.1.1>react-inspector": "9.0.0",
      "ip-address@>=10.0.0 <10.7.1": "10.7.1",
      "js-yaml@>=5.0.0 <5.4.1": "5.4.1",
      "nodemon>chokidar": "4.0.3",
      "@swc/cli>@xhmikosr/bin-wrapper": "-"
    },
    "packageExtensions": {
      "@swc/cli@0.8.1": {
        "dependencies": {
          "chokidar": "5.0.0"
        }
      },
      "drizzle-orm@0.45.2": {
        "dependencies": {
          "gel": "2.2.0",
          "mysql2": "3.24.4"
        }
      }
    },
    "patchedDependencies": {
      "@types/nodemailer@8.0.1": "patches/@types__nodemailer@8.0.1.patch",
      "drizzle-orm@0.45.2": "patches/drizzle-orm@0.45.2.patch",
      "@tanstack/router-core@1.171.27": "patches/@tanstack__router-core@1.171.27.patch",
      "vite@6.4.4": "patches/vite@6.4.4.patch",
      "gel@2.2.0": "patches/gel@2.2.0.patch",
      "nodemailer@10.0.12": "patches/nodemailer@10.0.12.patch",
      "nodemon@3.1.14": "patches/nodemon@3.1.14.patch",
      "@swc/cli@0.8.1": "patches/@swc__cli@0.8.1.patch",
      "@base-ui/react@1.7.0": "patches/@base-ui__react@1.7.0.patch",
      "pstree.remy@1.1.8": "patches/pstree.remy@1.1.8.patch",
      "sonner@2.0.8": "patches/sonner@2.0.8.patch"
    }
  }
}
