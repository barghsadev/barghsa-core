{
    "name": "@barghsa/api",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests",
        "test:coverage": "vitest run --coverage --passWithNoTests",
        "build": "nest build && pnpm generate:openapi",
        "generate:openapi": "node dist/src/generate-openapi",
        "dev": "nest build --watch",
        "start:prod": "node dist/src/main"
    },
    "dependencies": {
        "@barghsa/db": "workspace:*",
        "@barghsa/i18n": "workspace:*",
        "@barghsa/shared": "workspace:*",
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/swagger": "^11.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.0",
        "uuid": "14.0.2",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "11.2.1",
        "@swc/cli": "^0.6.0",
        "@swc/core": "^1.11.0",
        "@types/express": "^5.0.0",
        "@types/uuid": "11.0.0",
        "typescript": "^5.7.0"
    }
}