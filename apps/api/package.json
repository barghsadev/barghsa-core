{
  "name": "@barghsa/api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "healthcheck.js"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "nest build && playwright test",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "build": "nest build && pnpm generate:openapi",
    "generate:openapi": "node dist/src/generate-openapi",
    "dev": "nest build --watch --builder swc",
    "start:prod": "node dist/src/main"
  },
  "dependencies": {
    "@barghsa/db": "workspace:*",
    "@barghsa/i18n": "workspace:*",
    "@barghsa/shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "argon2": "0.45.1",
    "cookie": "0.7.2",
    "ioredis": "^5.11.1",
    "nodemailer": "9.0.5",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "uuid": "14.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "11.2.1",
    "@playwright/test": "1.62.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "^1.11.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/cookie": "0.6.0",
    "@types/express": "^5.0.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "^8.11.0",
    "pg": "^8.14.0",
    "testcontainers": "12.1.0",
    "typescript": "^5.7.0",
    "@barghsa/tsconfig": "workspace:*"
  }
}
