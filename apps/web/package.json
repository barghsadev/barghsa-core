    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "diff": "9.0.0",
    "dompurify": "3.4.15",
    "lucide-react": "1.34.0",
    "marked": "18.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "2.0.8"
